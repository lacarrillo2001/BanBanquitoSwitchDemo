# -----------------------------------------------------------------------------
# Plantilla de variables de entorno para despliegue manual.
#
# Este archivo es solo una guia y no se carga automaticamente.
# Debes copiar estos valores como variables de entorno reales del sistema
# operativo donde se ejecuta la aplicacion.
# -----------------------------------------------------------------------------

# Nombre del driver JDBC usado por Spring Boot para conectarse a PostgreSQL.
SPRING_DATASOURCE_DRIVER_CLASS_NAME=org.postgresql.Driver

# URL JDBC completa de la base de datos del switch.
# Ejemplo: jdbc:postgresql://10.10.10.20:5432/switch_banquito
SPRING_DATASOURCE_URL=

# Usuario de acceso a la base de datos PostgreSQL.
SPRING_DATASOURCE_USERNAME=

# Contrasena del usuario de base de datos.
SPRING_DATASOURCE_PASSWORD=

# Lista de origenes permitidos para CORS, separados por comas.
# Ejemplo: http://servidor-frontend:3000,https://empresa.com
SWITCH_CORS_ALLOWED_ORIGINS=

# URL base del Core Bancario para la integracion REST.
# Ejemplo: http://10.10.10.30:8081
CORE_BASE_URL=

# Modo de integracion con el Core.
# Valores esperados: rest o stub
CORE_INTEGRATION_MODE=rest

# Codigo funcional del subtipo de pago masivo configurado en el Core.
CORE_INTEGRATION_CODIGO_SUBTIPO_PAGO_MASIVO=

# Codigo contable de la cuenta de ingresos del servicio en el Core.
CORE_INTEGRATION_CODIGO_CUENTA_INGRESOS=

# Codigo contable de la cuenta de IVA del servicio en el Core.
CORE_INTEGRATION_CODIGO_CUENTA_IVA=

# Numero de cuenta contable o logica para ingresos del servicio.
CORE_INTEGRATION_NUMERO_CUENTA_INGRESOS=

# Numero de cuenta contable o logica para IVA del servicio.
CORE_INTEGRATION_NUMERO_CUENTA_IVA=

# Habilita autenticacion mock del Core cuando se trabaja en modo simulado.
# Valores esperados: true o false
CORE_INTEGRATION_MOCK_AUTENTICACION=true

# Habilita cuenta favorita mock del Core cuando se trabaja en modo simulado.
# Valores esperados: true o false
CORE_INTEGRATION_MOCK_CUENTA_FAVORITA_PAGOS=true

# Usuario empresarial aceptado por el mock del Core.
CORE_INTEGRATION_MOCK_USUARIO_EMPRESA=

# RUC empresarial devuelto por el mock del Core.
CORE_INTEGRATION_MOCK_RUC_EMPRESA=

# Numero de cuenta favorita devuelto por el mock del Core.
CORE_INTEGRATION_MOCK_CUENTA_FAVORITA_PAGOS_NUMERO=

# Saldo disponible devuelto por el mock del Core para la cuenta favorita.
CORE_INTEGRATION_MOCK_CUENTA_FAVORITA_PAGOS_SALDO_DISPONIBLE=

# Habilita el scheduler que procesa lotes encolados automaticamente.
# Valores esperados: true o false
SWITCH_COLA_SCHEDULER_ENABLED=true

# Tiempo en milisegundos entre ejecuciones del scheduler de cola.
SWITCH_COLA_SCHEDULER_FIXED_DELAY_MS=60000

# Numero maximo de lotes a procesar por ciclo del scheduler de cola.
SWITCH_COLA_MAX_LOTES_POR_CICLO=10

# Minutos que espera el sistema antes de reintentar un lote fallido.
SWITCH_COLA_REINTENTO_DELAY_MINUTOS=5

# Habilita el servidor SFTP embebido para carga de archivos.
# Valores esperados: true o false
SWITCH_SFTP_ENABLED=true

# Host o interfaz de red donde escuchara el servidor SFTP.
# Ejemplo: 0.0.0.0
SWITCH_SFTP_HOST=

# Puerto TCP del servidor SFTP embebido.
SWITCH_SFTP_PORT=

# Ruta del directorio raiz donde llegaran los archivos SFTP.
# Ejemplo: C:/switch-pagos/sftp-inbox
SWITCH_SFTP_ROOT_DIRECTORY=

# Tiempo en milisegundos entre escaneos del inbox SFTP.
SWITCH_SFTP_SCAN_FIXED_DELAY_MS=10000

# Tiempo minimo en milisegundos para considerar estable un archivo antes
# de procesarlo desde el inbox SFTP.
SWITCH_SFTP_FILE_SETTLE_MS=3000

# Si es true, la aplicacion termina el arranque cuando el SFTP falla.
# Valores esperados: true o false
SWITCH_SFTP_FAIL_ON_START_ERROR=false
