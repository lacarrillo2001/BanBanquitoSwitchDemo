# -----------------------------------------------------------------------------
# Variables de entorno locales para este proyecto.
# Este archivo es solo una plantilla y no se carga automaticamente.
# -----------------------------------------------------------------------------

# Nombre del driver JDBC usado por Spring Boot para conectarse a PostgreSQL.
SPRING_DATASOURCE_DRIVER_CLASS_NAME=org.postgresql.Driver

# URL JDBC completa de la base de datos del switch.
# Ejemplo: jdbc:postgresql://34.27.240.236:5432/banquito_switch
SPRING_DATASOURCE_URL=

# Usuario de acceso a la base de datos PostgreSQL.
SPRING_DATASOURCE_USERNAME=

# Contrasena del usuario de base de datos PostgreSQL.
SPRING_DATASOURCE_PASSWORD=

# Puerto TCP del servidor SFTP embebido.
SFTP_PORT=

# Directorio raiz donde el SFTP recibe archivos.
SFTP_ROOT_PATH=

# Usuario de autenticacion del servidor SFTP.
SFTP_USERNAME=

# Contrasena del usuario de autenticacion del servidor SFTP.
SFTP_PASSWORD=

# Lista de origenes permitidos para CORS, separados por comas.
SWITCH_CORS_ALLOWED_ORIGINS=

# Host del servidor SMTP para envio de notificaciones.
SPRING_MAIL_HOST=

# Puerto del servidor SMTP.
SPRING_MAIL_PORT=1025

# Usuario SMTP; dejar vacio si no aplica.
SPRING_MAIL_USERNAME=

# Contrasena SMTP; dejar vacio si no aplica.
SPRING_MAIL_PASSWORD=

# Indica si el servidor SMTP requiere autenticacion.
SPRING_MAIL_PROPERTIES_MAIL_SMTP_AUTH=false

# Indica si el servidor SMTP usa STARTTLS.
SPRING_MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_ENABLE=false

# Correo remitente usado por las notificaciones a beneficiarios.
SPRING_MAIL_FROM=

# URL base de la API de Mailpit usada para pruebas y consulta de mensajes.
MAILPIT_API_URL=
